<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0">
  <diagram id="diag-deployment" name="1. Mô hình triển khai 3 tầng">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" parent="1" value="HỆ THỐNG TEA POS - MÔ HÌNH KIẾN TRÚC TRIỂN KHAI 3 TẦNG (3-TIER ARCHITECTURE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=15;align=center;" vertex="1">
          <mxGeometry x="50" y="30" width="1220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="tier1" parent="1" value="TẦNG CLIENT (Presentation Tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=12;fontColor=#1e3a8a;" vertex="1">
          <mxGeometry x="50" y="110" width="340" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="t1_c1" parent="1" value="Máy POS Cảm Ứng Quầy Thu Ngân&#10;(Touchscreen POS)&#10;- Trình duyệt Chrome / Edge&#10;- Giao diện bán hàng POS&#10;- Kết nối máy in bill nhiệt 80mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="75" y="160" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="t1_c2" parent="1" value="Máy Tính / Laptop Quản Lý&#10;(Admin Workstation)&#10;- Trình duyệt Web&#10;- Trang Dashboard quản trị&#10;- Báo cáo doanh thu &amp; Thống kê" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="75" y="280" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="t1_c3" parent="1" value="Điện Thoại Khách Hàng&#10;(Customer Smartphone)&#10;- Mobile Web Browser&#10;- Xem menu &amp; Tùy chọn ly nước&#10;- Đặt nước online (Click &amp; Collect)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="75" y="400" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="t1_tech" parent="1" value="Công nghệ phía Client:&#10;HTML5, CSS3, JavaScript, AJAX&#10;Bootstrap 5 Responsive Layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#60a5fa;fontSize=11;fontStyle=2;align=center;" vertex="1">
          <mxGeometry x="75" y="520" width="290" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="tier2" parent="1" value="TẦNG ỨNG DỤNG (Web Application Tier)&#10;Apache Tomcat 11 - Port 8081 | Java 21 LTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=12;fontColor=#15803d;" vertex="1">
          <mxGeometry x="470" y="110" width="400" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="t2_c1" parent="1" value="Controller Layer (Java Servlets)&#10;- PosServlet: Bán hàng, tính tiền, in bill&#10;- AdminServlet: Quản trị menu, nhân sự&#10;- CustomerServlet: Đặt nước, giỏ hàng&#10;- AuthServlet: Đăng nhập, đổi mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="495" y="160" width="350" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="t2_c2" parent="1" value="Filter Layer (Security &amp; Auth Filter)&#10;- Kiểm tra phiên làm việc (HttpSession)&#10;- Chặn truy cập trái phép vào trang Admin&#10;- Khóa tài khoản tạm nếu sai mật khẩu liên tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="495" y="275" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t2_c3" parent="1" value="View Layer (JSP &amp; JSTL Templates)&#10;- pos.jsp, admin-dashboard.jsp, menu.jsp&#10;- Render HTML động và phản hồi JSON cho AJAX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="495" y="375" width="350" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t2_c4" parent="1" value="Business Services &amp; JDBC DAO&#10;- Xử lý chiết khấu voucher, tích lũy điểm thưởng&#10;- Câu lệnh SQL an toàn (PreparedStatement)&#10;- Thư viện Connection Pool HikariCP (Tối ưu kết nối)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="495" y="465" width="350" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="t2_tech" parent="1" value="Mô hình kiến trúc phần mềm: MVC Pattern&#10;(Model - View - Controller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#4ade80;fontSize=11;fontStyle=2;align=center;" vertex="1">
          <mxGeometry x="495" y="570" width="350" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="tier3" parent="1" value="TẦNG CƠ SỞ DỮ LIỆU (Data Tier)&#10;Microsoft SQL Server 2022 - Port 1433" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=12;fontColor=#c2410c;" vertex="1">
          <mxGeometry x="950" y="110" width="320" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="t3_c1" parent="1" value="Database: QuanLyQuanCafehetcuu1&#10;(19 bảng quan hệ chuẩn hóa)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fed7aa;strokeColor=#f97316;fontStyle=1;fontSize=12;align=center;" vertex="1">
          <mxGeometry x="975" y="160" width="270" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="t3_g1" parent="1" value="Bảng Nghiệp Vụ Bán Hàng:&#10;- NhanVien, KhachHang, VaiTro&#10;- DanhMuc, SanPham, SanPhamSize, Topping&#10;- HoaDon, HoaDonChiTiet, HoaDonTopping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="965" y="260" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="t3_g2" parent="1" value="Bảng Khuyến Mãi &amp; CRM Hội Viên:&#10;- KhuyenMai, KhachHangKhuyenMai&#10;- HangThanhVien, LichSuDiem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="965" y="380" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="t3_g3" parent="1" value="Bảng Vận Hành &amp; Nhật Ký Hệ Thống:&#10;- GiaoDichVietQR (Thanh toán quét mã)&#10;- NhatKyHoatDong (Audit Trail kiểm soát)&#10;- ThongKeNgay (Hỗ trợ báo cáo doanh thu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="965" y="490" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e1" parent="1" value="Giao thức HTTP / HTTPS&#10;(Port 8081 / AJAX Requests)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#2563eb;fontColor=#1d4ed8;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" source="tier1" target="tier2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" parent="1" value="Giao thức mạng TCP/IP&#10;(Port 1433 / JDBC Driver)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#ea580c;fontColor=#c2410c;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" source="tier2" target="tier3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
